# Connection is resolved from ConnectionStrings__Postgres first, then these discrete variables.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=raceservice
POSTGRES_USER=postgres
POSTGRES_PASSWORD=

# Token validation. Set Jwt__Authority in production so signing keys are fetched and rotated
# automatically from the UserService; the symmetric key is a local-development shortcut only.
Jwt__Authority=
Jwt__Issuer=racingvacing-userservice
Jwt__Audience=racingvacing-raceservice
Jwt__SigningKey=

Cors__AllowedOrigins__0=https://racingvacing.com
