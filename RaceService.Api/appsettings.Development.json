{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Information",
        "Microsoft.EntityFrameworkCore.Database.Command": "Information"
      }
    }
  },
  "Database": {
    "MigrateOnStartup": true,
    "SeedOnStartup": true
  },
  "Jwt": {
    "Issuer": "racingvacing-userservice",
    "Audience": "racingvacing-raceservice",
    "SigningKey": "development-only-signing-key-replace-me-with-32-bytes-minimum"
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:3000" ]
  }
}
